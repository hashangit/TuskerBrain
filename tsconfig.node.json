{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["./domain/*"],
      "@capabilities/*": ["./capabilities/*"],
      "@vendors/*": ["./vendors/*"],
      "@foundations/*": ["./foundations/*"],
      "@electron/*": ["./electron/*"]
    }
  },
  "include": ["vite.config.ts"]
}
