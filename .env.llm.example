# LLM Configuration for TuskerBrain
# Copy this file to .env.llm and fill in your API key

# =============================================================================
# ZAI API Configuration (Anthropic-compatible GLM coding plan)
# =============================================================================
# This configuration uses ZAI's Anthropic-compatible API with GLM models

# API Authentication Token (REQUIRED)
# Get your API key from ZAI dashboard
ANTHROPIC_AUTH_TOKEN=your_api_key_here

# API Base URL for ZAI (Anthropic-compatible endpoint)
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# Request timeout in milliseconds (50 minutes for long-running operations)
API_TIMEOUT_MS=3000000

# Model aliases for GLM coding plan
# Haiku-level: Fast, cheap model for simple tasks
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.5-air

# Sonnet-level: Balanced model for most tasks
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-4.7

# Opus-level: Most capable model for complex tasks
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5

# =============================================================================
# Alternative: Direct Anthropic API Configuration
# =============================================================================
# Uncomment the following lines to use the official Anthropic API instead

# ANTHROPIC_AUTH_TOKEN=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# API_TIMEOUT_MS=300000
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6
